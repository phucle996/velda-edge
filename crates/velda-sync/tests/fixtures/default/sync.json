{
  "schema_version": 1,
  "mode": "standalone",
  "source": {
    "type": "local",
    "path": "/etc/velda/config"
  },
  "sync": {
    "poll_interval_ms": 1000,
    "debounce_ms": 250
  },
  "storage": {
    "lkg_directory": "/var/lib/velda/lkg",
    "compiled_directory": "/var/lib/velda/runtime"
  },
  "notify": {
    "type": "uds",
    "socket": "/run/velda/edge.sock"
  }
}
