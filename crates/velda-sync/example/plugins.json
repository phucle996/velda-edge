{
  "schema_version": 1,
  "plugins": [
    {
      "id": "jwt_auth",
      "config": {
        "issuer": "https://identity.example.com",
        "audience": [
          "velda-api"
        ],
        "jwks_url": "https://identity.example.com/.well-known/jwks.json",
        "required": true
      }
    },
    {
      "id": "resource_limit",
      "config": {
        "max_body_size_bytes": 10485760,
        "max_concurrent_requests": 1000
      }
    },
    {
      "id": "rate_limit",
      "config": {
        "algorithm": "token_bucket",
        "backend": "memory",
        "rate_per_second": 500,
        "burst_capacity": 1000,
        "key_strategy": "priority",
        "key_headers": [
          "x-device-id",
          "x-api-key",
          "client_ip"
        ],
        "fallback_behavior": "memory",
        "batch_sync_interval_ms": 50,
        "batch_max_size": 1000,
        "redis_url": "none",
        "redis_username": "none",
        "redis_password": "none",
        "redis_tls_ca": "none",
        "redis_tls_cert": "none",
        "redis_tls_key": "none",
        "redis_timeout_ms": "none"
      }
    },
    {
      "id": "ip_filter",
      "priority": 100,
      "config": {
        "mode": "allow",
        "allow_cidrs": [
          "10.0.0.0/8",
          "192.168.1.0/24",
          "2001:db8::/32"
        ],
        "deny_cidrs": "none",
        "client_ip_source": "x_forwarded_for"
      }
    },
    {
      "id": "security_headers",
      "priority": 100,
      "config": {
        "hsts": {
          "enable": true,
          "max_age_secs": 31536000,
          "include_subdomains": true,
          "preload": false
        },
        "frame_options": "DENY",
        "content_type_nosniff": true,
        "referrer_policy": "strict-origin-when-cross-origin",
        "csp": "none",
        "permissions_policy": "none"
      }
    },
    {
      "id": "access_log",
      "config": {
        "include_request_id": true,
        "include_route_id": true,
        "include_upstream": true,
        "include_latency": true
      }
    },
    {
      "id": "waf",
      "config": {
        "mode": "block",
        "ruleset": "owasp_core"
      }
    }
  ]
}
