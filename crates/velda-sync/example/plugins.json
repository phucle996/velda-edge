{
  "schema_version": 1,
  "plugins": [
    {
      "id": "ip_filter",
      "config": {
        "mode": "allow",
        "allow_cidrs": [
          "10.0.0.0/8",
          "192.168.1.0/24",
          "2001:db8::/32"
        ],
        "deny_cidrs": [],
        "client_ip_source": "x_forwarded_for"
      }
    },
    {
      "id": "resource_limit",
      "config": {
        "max_uri_length": 8192,
        "max_headers_count": 128,
        "max_header_bytes": 32768,
        "max_single_header_bytes": 8192
      }
    },
    {
      "id": "waf_lite",
      "config": {
        "patterns": [
          "../",
          "..\\",
          "/etc/passwd",
          "' or '1'='1",
          "union select",
          "<script",
          "${jndi:"
        ]
      }
    },
    {
      "id": "jwt_auth",
      "config": {
        "algorithm": "HS256",
        "secret_key": "example-hmac-sha256-shared-secret-key",
        "public_key_pem": null,
        "token_sources": [
          {
            "type": "header",
            "name": "authorization",
            "prefix": "Bearer "
          },
          {
            "type": "cookie",
            "name": "access_token"
          }
        ],
        "validate_exp": true,
        "clock_skew_secs": 60,
        "issuer": "https://identity.internal.net",
        "audience": "api.velda.io",
        "claims_to_headers": {
          "sub": "x-user-id",
          "email": "x-user-email",
          "roles": "x-user-roles"
        },
        "assert_claims": {
          "iss": "https://identity.internal.net"
        },
        "cache_ttl_secs": 300
      }
    },
    {
      "id": "rate_limit",
      "config": {
        "algorithm": "token_bucket",
        "rate_per_second": 1000,
        "burst_capacity": 2000,
        "overdraft_percent": 5,
        "key_strategy": "hierarchical",
        "key_headers": [
          "x-tenant-id",
          "x-api-key",
          "client_ip"
        ],
        "fallback_behavior": "memory",
        "sync_interval_ms": 200
      }
    },
    {
      "id": "header_mutation",
      "config": {
        "set_headers": {
          "x-gateway-proxy": "velda-edge",
          "x-forwarded-proto": "https"
        },
        "remove_headers": [
          "x-powered-by",
          "server"
        ],
        "append_headers": {}
      }
    },
    {
      "id": "security_headers",
      "config": {
        "hsts": {
          "enable": true,
          "max_age_secs": 31536000,
          "include_subdomains": true,
          "preload": false
        },
        "frame_options": "DENY",
        "content_type_nosniff": true,
        "referrer_policy": "strict-origin-when-cross-origin",
        "content_security_policy": null,
        "permissions_policy": null,
        "cross_origin_opener_policy": "same-origin",
        "cross_origin_embedder_policy": "require-corp",
        "cross_origin_resource_policy": "same-origin",
        "cross_domain_policies": "none",
        "xss_protection": "0"
      }
    },
    {
      "id": "cors",
      "config": {
        "allow_origins": [
          "https://app.velda.io",
          "https://console.velda.io"
        ],
        "expose_headers": [
          "x-request-id"
        ],
        "allow_credentials": true
      }
    },
    {
      "id": "std_log_shipper",
      "config": {
        "target": "stdout",
        "format": "json",
        "flush_interval_ms": 1000,
        "max_batch_size": 1000
      }
    },
    {
      "id": "prometheus_exporter",
      "config": {
        "listen": "0.0.0.0:9090",
        "path": "/metrics",
        "protocol": "http",
        "scrape": {
          "timeout_ms": 5000,
          "max_concurrency": 16,
          "max_buffer_size_kb": 256
        },
        "tls": {
          "mode": "none",
          "cert_file": null,
          "key_file": null,
          "client_ca_file": null
        },
        "cors": {
          "enabled": false,
          "allow_origins": [],
          "allow_methods": [],
          "allow_headers": []
        },
        "auth": {
          "mode": "none",
          "token": null,
          "username": null,
          "password": null
        }
      }
    },
    {
      "id": "hmac_auth",
      "config": {
        "access_key_header": "x-access-key-id",
        "signature_header": "x-signature",
        "signature_algorithm": "hmac-sha256",
        "signature_encoding": "hex",
        "timestamp_header": "x-timestamp",
        "clock_skew_seconds": 60,
        "signed_headers": [
          "host",
          "x-timestamp",
          "x-nonce"
        ],
        "validate_request_body": true,
        "content_sha256_header": "x-content-sha256",
        "nonce_header": "x-nonce",
        "enforce_nonce": true,
        "credentials": [
          {
            "access_key_id": "client_fintech_partner_01",
            "secret_key": "sec_k89f2a019482bca881726c0981273412",
            "consumer_id": "fintech-partner-prod"
          }
        ]
      }
    },
    {
      "id": "oauth2_introspection",
      "config": {
        "etp_id": "keycloak-prod",
        "path": "/realms/master/protocol/openid-connect/token/introspect",
        "client_id": "velda-edge-gateway",
        "client_secret": "sec_gateway_secret_key_12345",
        "auth_method": "client_secret_basic",
        "token_headers": [
          "x-access-token",
          "authorization"
        ],
        "token_cookies": [
          "access_token"
        ],
        "token_query_params": [
          "token"
        ],
        "token_type_hint": "access_token",
        "cache_ttl_seconds": 300,
        "negative_cache_ttl_seconds": 10,
        "request_timeout_ms": 500,
        "required_scopes": [
          "read",
          "orders"
        ],
        "claims_to_headers": [
          {
            "claim": "sub",
            "header": "x-user-id"
          },
          {
            "claim": "client_id",
            "header": "x-client-id"
          },
          {
            "claim": "scope",
            "header": "x-authenticated-scope"
          }
        ],
        "hide_credentials": true,
        "fallback_behavior": "reject"
      }
    },
    {
      "id": "otlp_log_shipper",
      "config": {
        "etp_id": "otlp-main",
        "service_name": "velda-edge",
        "flush_interval_ms": 1000,
        "max_batch_size": 1000,
        "request_timeout_ms": 5000
      }
    },
    {
      "id": "loki_log_shipper",
      "config": {
        "etp_id": "loki-logs",
        "service_name": "velda-edge",
        "flush_interval_ms": 1000,
        "max_batch_size": 1000,
        "request_timeout_ms": 5000,
        "labels": {
          "env": "prod",
          "cluster": "edge-1"
        }
      }
    },
    {
      "id": "otlp_metrics_exporter",
      "config": {
        "etp_id": "otlp-main",
        "interval_secs": 15,
        "request_timeout_ms": 5000,
        "service_name": "velda-edge"
      }
    },
    {
      "id": "statsd_exporter",
      "config": {
        "etp_id": "statsd-main",
        "interval_secs": 10,
        "prefix": "velda",
        "dialect": "dogstatsd",
        "max_packet_size": 1432
      }
    },
    {
      "id": "clickhouse_log_shipper",
      "config": {
        "etp_id": "clickhouse-logs",
        "database": "velda_analytics",
        "format": "row_binary",
        "flush_interval_ms": 1000,
        "max_batch_size": 8000,
        "request_timeout_ms": 5000
      }
    },
    {
      "id": "kafka_log_shipper",
      "config": {
        "etp_id": "kafka-main",
        "topic": "velda-access-logs",
        "format": "json",
        "compression": "zstd",
        "acks": "leader",
        "partitioner": "round_robin",
        "flush_interval_ms": 1000,
        "max_batch_size": 8000,
        "request_timeout_ms": 5000,
        "metadata_refresh_ms": 300000
      }
    }
  ]
}
