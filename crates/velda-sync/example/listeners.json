{
  "schema_version": 1,
  "listeners": [
    {
      "id": "web-in",
      "address": "0.0.0.0:443",
      "transport": {
        "protocol": "tcp"
      },
      "application": {
        "protocol": "http2"
      },
      "tls": {
        "enabled": true
      },
      "limits": {
        "max_body_size": 10485760,
        "max_header_size": 65536,
        "max_headers": 64,
        "request_timeout_ms": 30000
      }
    },
    {
      "id": "grpc-in",
      "address": "0.0.0.0:50051",
      "transport": {
        "protocol": "tcp"
      },
      "application": {
        "protocol": "grpc"
      },
      "tls": {
        "enabled": true
      },
      "limits": {
        "max_body_size": 10485760,
        "max_header_size": 65536,
        "max_headers": 64,
        "request_timeout_ms": 30000
      }
    },
    {
      "id": "tcp-ingress",
      "address": "0.0.0.0:9000",
      "transport": {
        "protocol": "tcp"
      },
      "application": {
        "protocol": "raw"
      },
      "tls": {
        "enabled": false
      },
      "limits": {
        "max_body_size": 10485760,
        "max_header_size": 65536,
        "max_headers": 64,
        "request_timeout_ms": 30000
      }
    }
  ]
}