{
  "schema_version": 1,
  "listeners": [
    {
      "id": "web-in",
      "address": "0.0.0.0:443",
      "transport": {
        "protocol": "tcp"
      },
      "application": {
        "protocol": "http2",
        "streaming": "server"
      },
      "tls": {
        "enabled": true
      },
      "limits": {
        "max_body_size": 10485760,
        "max_header_size": 65536,
        "max_headers": 64,
        "idle_timeout_ms": 30000
      }
    },
    {
      "id": "grpc-in",
      "address": "0.0.0.0:50051",
      "transport": {
        "protocol": "tcp"
      },
      "application": {
        "protocol": "grpc",
        "streaming": "duplex"
      },
      "tls": {
        "enabled": true
      },
      "limits": {
        "max_body_size": 10485760,
        "max_header_size": 65536,
        "max_headers": 64,
        "idle_timeout_ms": 30000
      }
    },
    {
      "id": "tcp-ingress",
      "address": "0.0.0.0:9000",
      "transport": {
        "protocol": "tcp"
      },
      "application": {
        "protocol": "raw",
        "streaming": false
      },
      "tls": {
        "enabled": false
      },
      "limits": {
        "max_body_size": 10485760,
        "max_header_size": 65536,
        "max_headers": 64,
        "idle_timeout_ms": 30000
      }
    }
  ]
}