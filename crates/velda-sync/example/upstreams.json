      "health_check": {
        "passive": {
          "enabled": true,
          "max_consecutive_failures": 3,
          "cooldown_ms": 15000
        },
        "active": {
          "enabled": true,
          "interval_ms": 10000,
          "timeout_ms": 2000,
          "unhealthy_threshold": 3,
          "healthy_threshold": 2,
          "check_type": "tcp"
        }
      }
    },
    {
      "id": "realtime",
