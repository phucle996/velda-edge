{
  "schema_version": 1,
  "upstreams": [
    {
      "id": "users",
      "mode": "dns",
      "protocol": {
        "transport": "tcp",
        "application": "http",
        "version": "1.1"
      },
      "target": {
        "host": "users.default.svc.cluster.local",
        "port": 8080
      },
      "resolver": {
        "mode": "custom",
        "nameservers": [
          "10.96.0.10:53"
        ],
        "timeout_ms": 200,
        "retries": 2
      },
      "load_balancer": {
        "algorithm": "round_robin"
      },
      "timeouts": {
        "connect_ms": 500,
        "request_ms": 5000,
        "idle_ms": 30000
      },
      "health_check": {
        "passive": {
          "enabled": true,
          "max_consecutive_failures": 3,
          "cooldown_ms": 10000
        },
        "active": {
          "enabled": true,
          "interval_ms": 5000,
          "timeout_ms": 1000,
          "unhealthy_threshold": 3,
          "healthy_threshold": 2,
          "check_type": "http",
          "path": "/healthz",
          "expected_statuses": [200, 204]
        }
      }
    },
    {
      "id": "events",
      "mode": "endpoints",
      "protocol": {
        "transport": "tcp",
        "application": "http",
        "version": "1.1"
      },
      "endpoints": [
        {
          "address": "10.10.20.11:8080",
          "weight": 1
        },
        {
          "address": "10.10.20.12:8080",
          "weight": 1
        },
        {
          "address": "10.10.20.13:8080",
          "weight": 1
        }
      ],
      "load_balancer": {
        "algorithm": "least_connections"
      },
      "timeouts": {
        "connect_ms": 500,
        "request_ms": 30000,
        "idle_ms": 60000
      },
      "health_check": {
        "passive": {
          "enabled": true,
          "max_consecutive_failures": 3,
          "cooldown_ms": 10000
        }
      }
    },
    {
      "id": "grpc-users",
