FROM golang:1.27-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r velda && useradd -r -g velda -s /bin/false velda

WORKDIR /app

EXPOSE 8080
EXPOSE 9099

USER velda:velda

CMD ["go", "run", "./cmd/main.go"]
