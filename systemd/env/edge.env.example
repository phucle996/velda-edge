# Velda Edge Data Plane Environment Variables
# Location: /etc/velda/edge.env

# Storage directory for compiled LKG binary artifacts
VELDA_STORAGE_DIR=/var/lib/velda

# Unix Domain Socket for IPC reload notifications from velda-sync
VELDA_SOCKET_PATH=/run/velda/edge.sock

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info
