# Velda Sync Reconciler Daemon Environment Variables
# Location: /etc/velda/sync.env

# Sync Mode: "standalone" (watches local JSON/YAML files) or "control_plane" (polls Go control plane)
VELDA_SYNC_MODE=standalone

# Storage and IPC paths (must match velda-edge)
VELDA_STORAGE_DIR=/var/lib/velda
VELDA_SOCKET_PATH=/run/velda/edge.sock
VELDA_STAGING_DIR=/var/lib/velda/staging

# Polling interval in milliseconds
VELDA_POLL_INTERVAL_MS=1000

# When VELDA_SYNC_MODE=standalone:
VELDA_CONFIG_DIR=/etc/velda/config

# When VELDA_SYNC_MODE=control_plane:
# VELDA_CONTROL_PLANE_ENDPOINT=http://127.0.0.1:9099
# VELDA_CONTROL_PLANE_TIMEOUT_MS=10000
# VELDA_CA_CERT=/etc/velda/tls/ca.crt
# VELDA_CLIENT_CERT=/etc/velda/tls/client.crt
# VELDA_CLIENT_KEY=/etc/velda/tls/client.key

# Logging format and level
VELDA_SYNC_LOG_LEVEL=info
VELDA_SYNC_LOG_FORMAT=full
