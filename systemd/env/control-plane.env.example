# Velda Control Plane Environment Variables
# Location: /etc/velda/control-plane.env

# HTTP API & Console Port
PORT=8080

# gRPC Control Plane Port
GRPC_PORT=9099

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=velda_edge
DB_SSLMODE=disable

# Gin Mode: release / debug / test
GIN_MODE=release
