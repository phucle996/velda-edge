[Unit]
Description=Velda Control Plane and Console
Documentation=https://github.com/phucle996/velda-edge
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=velda
Group=velda

EnvironmentFile=-/etc/velda/control-plane.env
ExecStart=/usr/local/bin/velda-control-plane

Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=15s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

StateDirectory=velda
RuntimeDirectory=velda
WorkingDirectory=/var/lib/velda
ReadWritePaths=/var/lib/velda /run/velda

LimitNOFILE=65536
TasksMax=infinity

[Install]
WantedBy=multi-user.target
