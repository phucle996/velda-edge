        "timeout_ms": 500,
        "retries": 1
      },
      "load_balancer": {
        "algorithm": "least_connections"
      },
      "timeouts": {
        "connect_ms": 500,
        "request_ms": 900000,
        "idle_ms": 900000
      },
      "pool": {
        "concurrency_shards": 2,
        "max_idle_per_key": 64,
        "idle_timeout_ms": 60000,
        "max_lifetime_ms": 3600000
      }
    },
